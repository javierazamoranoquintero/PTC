# ==============================================================================
# PLANTILLA de variables de entorno del PTC
# ==============================================================================
# ¿Para qué sirve este archivo?
# Tu app lee la configuración real desde un archivo ".env" (revisa config/config.js),
# pero ese archivo NUNCA se sube a git (está en .gitignore) porque contiene
# contraseñas y secretos. El problema es que si ".env" no se sube, nadie más
# (ni tú misma en otro computador) sabe qué variables tiene que crear.
#
# La solución estándar es este archivo ".env.example": es igual a ".env" pero
# con valores de ejemplo en vez de reales, y SÍ se sube a git.
#
# Cómo usarlo:
#   1. Copia este archivo y renómbralo a ".env"        -> cp .env.example .env
#   2. Reemplaza los valores de ejemplo por los reales.
#   3. Nunca subas tu ".env" real a git.
# ==============================================================================

# --- Base de datos PostgreSQL ---
# Si vas a correr la app con "pnpm run dev" DIRECTO en tu máquina (sin Docker),
# y la base de datos vive en el contenedor de docker-compose, usa:
#   DB_HOST=localhost
#   DB_PORT=5433   <- este es el puerto mapeado en docker-compose.yml ("5433:5432")
#
# Si vas a correr la app DENTRO de docker-compose (junto con el contenedor "db"),
# usa el nombre del servicio como host y el puerto interno del contenedor:
#   DB_HOST=db
#   DB_PORT=5432
DB_HOST=localhost
DB_PORT=5433
DB_USER=ptc_user
DB_PASSWORD=cambia_esta_clave
DB_NAME=ptc_db

# --- Sesión (express-session) ---
# Debe ser un texto largo y aleatorio, se usa para firmar las cookies de sesión.
# Puedes generar uno rápido con este comando en la terminal:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio

# --- Servidor ---
# Puerto en el que escucha Express. Si no se define, app.js usa 3000 por defecto.
PORT=3000