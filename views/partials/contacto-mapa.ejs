<section class="py-24 bg-tertiary text-neutral">
    <div class="px-margin-desktop max-w-container-max mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">

        <div>
            <h2 class="font-heading text-3xl font-bold mb-6 text-primary">¿Listo para jugar?</h2>
            <p class="font-body text-neutral/70 mb-10">
                Texto placeholder invitando a reservar tu hora o consultar por membresías.
            </p>
            <div class="flex flex-wrap gap-4">
                <a href="/canchas" class="bg-secondary text-neutral px-8 py-3 rounded-lg font-bold border border-primary/20 hover:scale-105 transition-transform active:scale-95">
                    Ir al Sistema de Reservas
                </a>
                <!-- Antes iba a /contacto: se decidió no construir esa página
                     aparte y en su lugar mostrar los datos de contacto en el
                     footer (ver partials/footer.ejs), así que este botón
                     ahora abre directo el correo del club. -->
                <a href="mailto:contacto@pichilemutennisclub.cl" class="border border-primary/30 text-primary px-8 py-3 rounded-lg font-bold hover:bg-primary/5 transition-colors">
                    Contactar
                </a>
            </div>
        </div>

        <div class="rounded-2xl overflow-hidden h-80 coastal-shadow relative">
            <iframe
                    src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d1893.100823084323!2d-71.98588303852817!3d-34.386910444325295!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x96615762042a8afd%3A0xa6a13d57d037a91b!2sPichilemu%20Tennis%20Club!5e0!3m2!1ses!2scl!4v1786136407171!5m2!1ses!2scl"
                    width="100%" height="100%" style="border:0;"
                    allowfullscreen=""
                    loading="lazy"
                    referrerpolicy="strict-origin-when-cross-origin"
                    title="Ubicación <%= nombreClub %>">
            </iframe>
        </div>

    </div>
</section>