<header class="fixed top-0 z-50 w-full bg-primary/90 backdrop-blur-md border-b border-white/10 shadow-lg transition-all duration-300 h-20">
    <nav class="flex justify-between items-center w-full px-margin-desktop max-w-container-max mx-auto h-full">

        <div class="flex items-center gap-3">
            <!-- Espacio reservado para el logo del club -->
            <img src="/images/logo-ptc.png" alt="Logo <%= nombreClub %>" class="icon w-12 h-12">
            <span class="font-heading text-2xl font-bold text-white"><%= nombreClub %></span>
        </div>

        <%
        // "paginaActual" nos dice en qué página estamos, para poder resaltar
        // el link correspondiente en el menú (en vez de dejar "Inicio" marcado
        // siempre, sin importar dónde estés navegando). Si una vista todavía no
        // manda este dato, usamos 'inicio' por defecto para no romper nada.
        const activa = typeof paginaActual !== 'undefined' ? paginaActual : 'inicio';
        const claseActiva = 'font-body text-sm text-white font-bold border-b-2 border-secondary pb-1';
        const claseInactiva = 'font-body text-sm text-white/80 hover:text-white transition-colors';
        %>

        <div class="hidden md:flex items-center justify-center flex-1 gap-8">
            <a href="/" class="<%= activa === 'inicio' ? claseActiva : claseInactiva %>">Inicio</a>
            <a href="/sobre-el-club" class="<%= activa === 'sobre-el-club' ? claseActiva : claseInactiva %>">Sobre el Club</a>
            <a href="/canchas" class="<%= activa === 'canchas' ? claseActiva : claseInactiva %>">Canchas</a>
            <a href="/escalerilla" class="<%= activa === 'escalerilla' ? claseActiva : claseInactiva %>">Escalerilla</a>
            <a href="/noticias" class="<%= activa === 'noticias' ? claseActiva : claseInactiva %>">Noticias</a>
        </div>

        <div class="flex items-center gap-4">
            <% if (usuario) { %>
                <!-- "Hola, nombre" ES el link a TU panel privado: evita agregar
                     un ítem más al menú (que antes desordenaba el navbar en
                     pantallas medianas) y es un patrón común: el nombre/avatar
                     de la cuenta lleva a tu panel privado. Para un admin, ese
                     panel es el de Administración (con el sidebar hacia
                     Reservas/Escalerilla/Noticias/Torneos); para un socio
                     normal, sigue siendo el Panel del Socio de siempre. -->
                <!-- "capitalize" es puramente visual (CSS): pone en mayúscula la
                     primera letra de cada palabra al mostrarlo, sin tocar cómo
                     está guardado el nombre en la base de datos. -->
                <a href="<%= usuario.rol === 'admin' ? '/admin' : '/panel-socio' %>" class="hidden md:inline font-body text-sm text-white/80 hover:text-white hover:underline transition-colors">
                    Hola, <span class="font-bold text-white capitalize"><%= usuario.nombre %></span>
                </a>
                <form action="/autenticacion/logout" method="POST" class="inline">
                    <button type="submit" class="px-6 py-2 border border-white text-white font-bold rounded-lg hover:bg-white/10 transition-all active:scale-95">
                        Cerrar sesión
                    </button>
                </form>
            <% } else { %>
                <a href="/autenticacion/login" class="px-6 py-2 border border-white text-white font-bold rounded-lg hover:bg-white/10 transition-all active:scale-95">
                    Ingresar
                </a>
            <% } %>
            <button class="md:hidden flex items-center p-2 text-white">
                <!-- Espacio reservado para ícono de menú hamburguesa -->
                <span class="icon"></span>
            </button>
        </div>

    </nav>
</header>