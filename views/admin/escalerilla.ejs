<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head', { title: title }) %>
</head>
<body class="flex flex-col min-h-screen bg-tertiary/30">

<%- include('../partials/navbar', { nombreClub: nombreClub, paginaActual: 'admin' }) %>

<div class="flex-grow flex items-start pt-20 w-full">
    <%- include('partials/sidebar', { paginaActual: 'escalerilla' }) %>

    <main class="flex-grow min-w-0">
        <div class="px-6 md:px-10 py-10 max-w-5xl">

            <%- include('partials/encabezadoSeccion', {
            seccion: 'escalerilla',
            titulo: 'Escalerilla',
            subtitulo: 'Ranking único y general del club. Se actualiza a mano, sin cálculo automático.',
            }) %>

            <% if (error) { %>
                <div class="mb-6 rounded-lg bg-red-50 border border-red-200 px-4 py-3">
                    <p class="font-body text-sm text-red-700"><%= error %></p>
                </div>
            <% } %>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

                <!-- Agregar jugador nuevo a la escalerilla -->
                <div class="lg:col-span-1 bg-white coastal-shadow rounded-xl p-6">
                    <h2 class="font-heading text-lg font-bold text-primary mb-4">Agregar jugador</h2>

                    <% if (usuariosDisponibles.length === 0) { %>
                        <p class="font-body text-sm text-neutral/60">
                            Todos los socios ya están en la escalerilla.
                        </p>
                    <% } else { %>
                        <form action="/admin/escalerilla" method="POST" class="space-y-4">
                            <div>
                                <label for="usuarioId" class="block font-body text-sm font-medium text-neutral mb-1">Socio</label>
                                <select
                                        id="usuarioId"
                                        name="usuarioId"
                                        required
                                        class="w-full rounded-lg border border-neutral/20 px-4 py-2 font-body text-sm focus:outline-none focus:ring-2 focus:ring-primary"
                                >
                                    <option value="" disabled selected>Elige un socio...</option>
                                    <% usuariosDisponibles.forEach((usuario) => { %>
                                        <option value="<%= usuario.id %>"><%= usuario.nombre %></option>
                                    <% }) %>
                                </select>
                            </div>
                            <div>
                                <label for="posicion" class="block font-body text-sm font-medium text-neutral mb-1">Posición</label>
                                <input
                                        type="number"
                                        id="posicion"
                                        name="posicion"
                                        min="1"
                                        required
                                        class="w-full rounded-lg border border-neutral/20 px-4 py-2 font-body text-sm focus:outline-none focus:ring-2 focus:ring-primary"
                                >
                            </div>
                            <button
                                    type="submit"
                                    class="w-full bg-primary text-white font-heading font-bold py-2.5 rounded-lg hover:bg-primary/90 transition-all active:scale-95"
                            >
                                Agregar a la escalerilla
                            </button>
                        </form>
                    <% } %>
                </div>

                <!-- Ranking actual, editable fila por fila -->
                <div class="lg:col-span-2 bg-white coastal-shadow rounded-xl p-6">
                    <h2 class="font-heading text-lg font-bold text-primary mb-4">Ranking actual</h2>

                    <% if (jugadores.length === 0) { %>
                        <p class="font-body text-sm text-neutral/60">Todavía no hay jugadores en la escalerilla.</p>
                    <% } else { %>
                        <ul class="divide-y divide-tertiary">
                            <% jugadores.forEach((jugador) => { %>
                                <li class="py-3 flex items-center gap-4">
                                <span class="w-8 h-8 rounded-full bg-tertiary text-primary font-bold flex items-center justify-center text-xs flex-shrink-0">
                                    <%= jugador.posicion %>
                                </span>
                                    <div class="flex-grow min-w-0">
                                        <p class="font-body font-semibold text-primary truncate"><%= jugador.nombre %></p>
                                        <% if (jugador.marcaRaqueta) { %>
                                            <p class="font-body text-xs text-neutral/50"><%= jugador.marcaRaqueta %></p>
                                        <% } %>
                                    </div>
                                    <form
                                            action="/admin/escalerilla/<%= jugador.usuarioId %>/actualizar"
                                            method="POST"
                                            class="flex items-center gap-2 flex-shrink-0"
                                    >
                                        <input
                                                type="number"
                                                name="posicion"
                                                min="1"
                                                value="<%= jugador.posicion %>"
                                                class="w-16 rounded-lg border border-neutral/20 px-2 py-1.5 font-body text-sm text-center focus:outline-none focus:ring-2 focus:ring-primary"
                                        >
                                        <button type="submit" class="font-body text-xs font-bold text-primary hover:underline">
                                            Guardar
                                        </button>
                                    </form>
                                    <form
                                            action="/admin/escalerilla/<%= jugador.usuarioId %>/quitar"
                                            method="POST"
                                            onsubmit="return confirm('¿Sacar a este jugador de la escalerilla?');"
                                    >
                                        <button type="submit" class="font-body text-xs font-bold text-red-600 hover:underline">
                                            Quitar
                                        </button>
                                    </form>
                                </li>
                            <% }) %>
                        </ul>
                    <% } %>
                </div>

            </div>
        </div>
    </main>
</div>

<%- include('../partials/footer') %>

</body>
</html>