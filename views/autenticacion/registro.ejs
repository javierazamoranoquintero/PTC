<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head', { title: title }) %>
</head>
<body class="flex flex-col min-h-screen bg-tertiary">

<%- include('../partials/navbar') %>

<main class="flex-grow flex items-center justify-center px-margin-mobile md:px-margin-desktop py-32">
    <div class="w-full max-w-md bg-white rounded-xl coastal-shadow p-8 md:p-10">

        <h1 class="font-heading text-2xl font-bold text-primary mb-2">Crear cuenta</h1>
        <p class="font-body text-sm text-neutral/70 mb-6">Únete al club para reservar canchas e inscribirte en clases.</p>

        <% if (error) { %>
            <div class="mb-6 rounded-lg bg-red-50 border border-red-200 px-4 py-3">
                <p class="font-body text-sm text-red-700"><%= error %></p>
            </div>
        <% } %>

        <!-- enctype="multipart/form-data" es OBLIGATORIO para que la foto viaje
             junto con el resto del formulario. Sin esto, el archivo elegido
             simplemente no llega al servidor (req.file queda vacío), aunque
             el resto de los campos de texto sí funcionen normalmente. -->
        <form action="/autenticacion/registro" method="POST" enctype="multipart/form-data" class="space-y-5">
            <div>
                <label for="nombre" class="block font-body text-sm font-medium text-neutral mb-1">Nombre completo</label>
                <input
                        type="text"
                        id="nombre"
                        name="nombre"
                        value="<%= valores.nombre %>"
                        required
                        class="w-full rounded-lg border border-neutral/20 px-4 py-2 font-body focus:outline-none focus:ring-2 focus:ring-primary"
                >
            </div>

            <div>
                <label for="foto" class="block font-body text-sm font-medium text-neutral mb-1">Foto de perfil</label>
                <input
                        type="file"
                        id="foto"
                        name="foto"
                        accept="image/jpeg,image/png,image/webp"
                        required
                        class="w-full rounded-lg border border-neutral/20 font-body file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:bg-primary file:text-white file:font-semibold file:cursor-pointer hover:file:bg-primary/90"
                >
                <p class="font-body text-xs text-neutral/50 mt-1">Formatos JPG, PNG o WEBP. Máximo 2MB.</p>
            </div>

            <div>
                <label for="edad" class="block font-body text-sm font-medium text-neutral mb-1">Edad</label>
                <input
                        type="number"
                        id="edad"
                        name="edad"
                        value="<%= valores.edad %>"
                        min="3"
                        max="100"
                        required
                        class="w-full rounded-lg border border-neutral/20 px-4 py-2 font-body focus:outline-none focus:ring-2 focus:ring-primary"
                >
            </div>

            <div>
                <span class="block font-body text-sm font-medium text-neutral mb-1">Sexo</span>
                <div class="flex flex-wrap gap-4">
                    <label class="flex items-center gap-2 font-body text-sm text-neutral">
                        <input type="radio" name="sexo" value="femenino" required <%= valores.sexo === 'femenino' ? 'checked' : '' %> class="text-primary focus:ring-primary">
                        Femenino
                    </label>
                    <label class="flex items-center gap-2 font-body text-sm text-neutral">
                        <input type="radio" name="sexo" value="masculino" required <%= valores.sexo === 'masculino' ? 'checked' : '' %> class="text-primary focus:ring-primary">
                        Masculino
                    </label>
                    <label class="flex items-center gap-2 font-body text-sm text-neutral">
                        <input type="radio" name="sexo" value="prefiero_no_decir" required <%= valores.sexo === 'prefiero_no_decir' ? 'checked' : '' %> class="text-primary focus:ring-primary">
                        Prefiero no decir
                    </label>
                </div>
            </div>

            <div>
                <span class="block font-body text-sm font-medium text-neutral mb-1">¿Qué juegas en el club?</span>
                <div class="flex flex-wrap gap-4">
                    <label class="flex items-center gap-2 font-body text-sm text-neutral">
                        <input type="checkbox" name="juegaTenis" value="on" <%= valores.juegaTenis ? 'checked' : '' %> class="rounded text-primary focus:ring-primary">
                        Tenis
                    </label>
                    <label class="flex items-center gap-2 font-body text-sm text-neutral">
                        <input type="checkbox" name="juegaPadel" value="on" <%= valores.juegaPadel ? 'checked' : '' %> class="rounded text-primary focus:ring-primary">
                        Pádel
                    </label>
                </div>
                <p class="font-body text-xs text-neutral/50 mt-1">Marca al menos una opción (puedes marcar las dos).</p>
            </div>

            <div>
                <label for="marcaRaqueta" class="block font-body text-sm font-medium text-neutral mb-1">Marca de tu raqueta</label>
                <input
                        type="text"
                        id="marcaRaqueta"
                        name="marcaRaqueta"
                        value="<%= valores.marcaRaqueta %>"
                        placeholder="Ej: Wilson Pro Staff 97"
                        required
                        class="w-full rounded-lg border border-neutral/20 px-4 py-2 font-body focus:outline-none focus:ring-2 focus:ring-primary"
                >
            </div>
            <div>
                <label for="email" class="block font-body text-sm font-medium text-neutral mb-1">Correo electrónico</label>
                <input
                        type="email"
                        id="email"
                        name="email"
                        value="<%= valores.email %>"
                        required
                        class="w-full rounded-lg border border-neutral/20 px-4 py-2 font-body focus:outline-none focus:ring-2 focus:ring-primary"
                >
            </div>

            <div>
                <label for="password" class="block font-body text-sm font-medium text-neutral mb-1">Contraseña</label>
                <input
                        type="password"
                        id="password"
                        name="password"
                        minlength="8"
                        required
                        class="w-full rounded-lg border border-neutral/20 px-4 py-2 font-body focus:outline-none focus:ring-2 focus:ring-primary"
                >
                <p class="font-body text-xs text-neutral/50 mt-1">Mínimo 8 caracteres.</p>
            </div>

            <div>
                <label for="confirmarPassword" class="block font-body text-sm font-medium text-neutral mb-1">Confirmar contraseña</label>
                <input
                        type="password"
                        id="confirmarPassword"
                        name="confirmarPassword"
                        minlength="8"
                        required
                        class="w-full rounded-lg border border-neutral/20 px-4 py-2 font-body focus:outline-none focus:ring-2 focus:ring-primary"
                >
            </div>

            <button
                    type="submit"
                    class="w-full bg-primary text-white font-heading font-bold py-3 rounded-lg hover:bg-primary/90 transition-all active:scale-95"
            >
                Crear cuenta
            </button>
        </form>

        <p class="font-body text-sm text-neutral/70 mt-6 text-center">
            ¿Ya tienes cuenta?
            <a href="/autenticacion/login" class="text-primary font-semibold hover:underline">Inicia sesión</a>
        </p>
    </div>
</main>

<%- include('../partials/footer') %>

</body>
</html>