<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('partials/head', { title: 'Escalerilla' }) %>
</head>
<body class="flex flex-col min-h-screen">

<%- include('partials/navbar', { nombreClub: nombreClub, paginaActual: 'escalerilla' }) %>

<main class="flex-grow pt-32 pb-20 px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto w-full">

    <!-- Íconos de raqueta compartidos (2 colores). Definidos en un partial aparte para
         poder reutilizarlos también en el Perfil del Socio más adelante. -->
    <%- include('partials/iconos-raqueta') %>

    <%
    // Asigna un color de raqueta FIJO según la posición del jugador (par/impar),
    // así cada jugador siempre sale con el mismo color, sin importar cuántas veces
    // se recargue la página. Si más adelante quieres agregar un 3er color, alcanza
    // con sumar un caso acá y su símbolo correspondiente en el partial.
    function iconoRaqueta(posicion) {
        return posicion % 2 === 0
                ? { id: 'icono-raqueta-rosa', viewBox: '0 0 64 64' }
                : { id: 'icono-raqueta-azul', viewBox: '0 0 128 128' };
    }
    %>

    <header class="mb-12">
        <h1 class="font-heading text-3xl md:text-5xl font-bold text-primary mb-4">Escalerilla General</h1>
        <p class="font-body text-neutral/70 max-w-2xl">Consulta el ranking actualizado de nuestros socios. Compite, sube posiciones y mantente en la cima del <%= nombreClub %>.</p>
    </header>

    <% if (tramos.length === 0) { %>

        <div class="bg-tertiary rounded-2xl p-12 text-center">
            <p class="font-body text-neutral/70">Todavía no hay socios cargados en la escalerilla. Cuando el admin asigne las primeras posiciones, van a aparecer acá.</p>
        </div>

    <% } else { %>

        <!-- Controles para elegir el tramo (select en mobile, pastillas en desktop) -->
        <div class="bg-white rounded-2xl coastal-shadow border border-primary/10 mb-6 p-4 flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div>
                <h3 class="font-heading text-base font-bold text-primary">Clasificación por tramos</h3>
                <p class="font-body text-xs text-neutral/60">Mostrando 10 jugadores por bloque</p>
            </div>
            <div class="flex flex-wrap items-center gap-3">
                <label for="tramo-select" class="sr-only">Seleccionar tramo</label>
                <select id="tramo-select" data-tramo-select class="border border-primary/20 rounded-lg pl-4 pr-9 py-2 font-body text-sm font-bold text-primary focus:outline-none focus:border-primary cursor-pointer">
                    <% tramos.forEach((tramo) => { %>
                        <option value="<%= tramo.etiqueta %>">Posiciones <%= tramo.etiqueta %></option>
                    <% }) %>
                </select>
                <div class="hidden sm:flex items-center bg-tertiary rounded-lg p-1 gap-1">
                    <% tramos.forEach((tramo, i) => { %>
                        <button type="button" data-tramo-target="<%= tramo.etiqueta %>" class="px-3 py-1.5 rounded text-xs font-bold transition-all <%= i === 0 ? 'bg-primary text-white' : 'text-neutral/60 hover:text-primary' %>"><%= tramo.etiqueta %></button>
                    <% }) %>
                </div>
            </div>
        </div>

        <% tramos.forEach((tramo, indiceTramo) => { %>
            <div data-tramo-bloque="<%= tramo.etiqueta %>" <%= indiceTramo === 0 ? '' : 'hidden' %>>
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter">

                    <!-- Destacado del tramo: el de menor posición dentro de este bloque -->
                    <div class="lg:col-span-4">
                        <% if (tramo.destacado) { %>
                            <div class="bg-primary rounded-2xl coastal-shadow overflow-hidden relative min-h-[400px] flex flex-col justify-end">
                                <div class="absolute inset-0 z-0">
                                    <div class="w-full h-full bg-cover bg-center opacity-60" style="background-image: url('/images/socio-<%= tramo.destacado.usuarioId %>.jpg');"></div>
                                </div>
                                <div class="relative z-10 p-6 bg-gradient-to-t from-primary via-primary/80 to-transparent">
                                    <div class="inline-flex items-center gap-2 bg-secondary text-neutral px-3 py-1.5 rounded-lg font-heading font-bold text-xs mb-4">
                                        <span class="icon"></span>
                                        <span>N.° <%= tramo.destacado.posicion %> DEL RANKING</span>
                                    </div>
                                    <h2 class="text-white font-heading text-xl font-bold mb-1"><%= tramo.destacado.nombre %></h2>
                                    <p class="text-white/80 font-body text-sm inline-flex items-center gap-2">
                                        <% if (tramo.destacado.marcaRaqueta) { %>
                                            <% const iconoDestacado = iconoRaqueta(tramo.destacado.posicion); %>
                                            <svg class="w-5 h-5 flex-shrink-0" viewBox="<%= iconoDestacado.viewBox %>" aria-hidden="true"><use href="#<%= iconoDestacado.id %>"></use></svg>
                                            <%= tramo.destacado.marcaRaqueta %>
                                        <% } else { %>
                                            Raqueta sin registrar
                                        <% } %>
                                    </p>
                                </div>
                            </div>
                        <% } %>
                    </div>

                    <!-- Tabla del tramo -->
                    <div class="lg:col-span-8">
                        <div class="bg-white rounded-2xl coastal-shadow border border-primary/10 overflow-hidden">
                            <div class="overflow-x-auto">
                                <table class="w-full text-left border-collapse">
                                    <thead>
                                    <tr class="bg-tertiary border-b border-primary/10">
                                        <th class="px-6 py-4 font-body text-xs text-neutral/60 uppercase tracking-wider w-24">Pos</th>
                                        <th class="px-6 py-4 font-body text-xs text-neutral/60 uppercase tracking-wider">Jugador</th>
                                        <th class="px-6 py-4 font-body text-xs text-neutral/60 uppercase tracking-wider">Raqueta</th>
                                    </tr>
                                    </thead>
                                    <tbody class="divide-y divide-primary/10">
                                    <% if (tramo.jugadores.length === 0) { %>
                                        <tr>
                                            <td colspan="3" class="px-6 py-8 text-center font-body text-sm text-neutral/60">Aún no hay jugadores en este tramo.</td>
                                        </tr>
                                    <% } %>
                                    <% tramo.jugadores.forEach((jugador) => { %>
                                        <tr class="hover:bg-tertiary/40 transition-colors">
                                            <td class="px-6 py-4">
                                                <div class="w-11 h-11 relative flex items-center justify-center">
                                                    <svg class="w-11 h-11" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                        <circle cx="22" cy="22" r="20" fill="#D4FF00" stroke="#B8DF00" stroke-width="1.5"></circle>
                                                        <path d="M 7 13 C 15 15, 20 22, 21 39" stroke="#ffffff" stroke-width="2" stroke-linecap="round" fill="none" opacity="0.9"></path>
                                                        <path d="M 37 31 C 29 29, 24 22, 23 5" stroke="#ffffff" stroke-width="2" stroke-linecap="round" fill="none" opacity="0.9"></path>
                                                    </svg>
                                                    <span class="absolute font-heading font-bold text-primary text-sm"><%= String(jugador.posicion).padStart(2, '0') %></span>
                                                </div>
                                            </td>
                                            <td class="px-6 py-4 font-body font-semibold text-primary"><%= jugador.nombre %></td>
                                            <td class="px-6 py-4 font-body text-sm text-neutral/70">
                                                <% if (jugador.marcaRaqueta) { %>
                                                    <% const iconoFila = iconoRaqueta(jugador.posicion); %>
                                                    <span class="inline-flex items-center gap-2">
                                        <svg class="w-5 h-5 flex-shrink-0" viewBox="<%= iconoFila.viewBox %>" aria-hidden="true"><use href="#<%= iconoFila.id %>"></use></svg>
                                        <%= jugador.marcaRaqueta %>
                                    </span>
                                                <% } else { %>
                                                    —
                                                <% } %>
                                            </td>
                                        </tr>
                                    <% }) %>
                                    </tbody>
                                </table>
                            </div>

                            <!-- Pie: resumen + paginación (comparte los mismos data-tramo-target que las pastillas de arriba) -->
                            <div class="p-4 bg-tertiary/40 border-t border-primary/10 flex flex-col sm:flex-row items-center justify-between gap-4">
                                <div class="font-body text-xs text-neutral/60">
                                    Mostrando <span class="font-bold text-primary"><%= tramo.etiqueta %></span> de <span class="font-bold text-primary"><%= totalJugadores %></span> jugadores
                                </div>
                                <div class="flex items-center gap-1.5">
                                    <% tramos.forEach((otroTramo, i) => { %>
                                        <button type="button" data-tramo-target="<%= otroTramo.etiqueta %>" class="w-9 h-9 rounded-lg border border-primary/20 font-bold text-xs flex items-center justify-center transition-colors <%= i === indiceTramo ? 'bg-primary text-white' : 'text-primary hover:bg-tertiary' %>"><%= i + 1 %></button>
                                    <% }) %>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        <% }) %>

    <% } %>

</main>
<%- include('partials/footer') %>
<script src="/javascripts/escalerilla.js" defer></script>
</body>
</html>